# ── Clerk (authentication) ──
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx

# Clerk redirect routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/portal/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal

# ── Invite-only access ──
# Comma-separated list of emails allowed into the portal.
# If empty or not set, ALL users are blocked from /portal (safe default).
ALLOWED_EMAILS=tu-email@dominio.com

# ── Groq (chatbot AI) ──
# Get this from https://console.groq.com
GROQ_API_KEY=gsk_xxxxx
